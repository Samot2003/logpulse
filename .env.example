# Settings for `docker compose up`. Copy this file to .env (git ignores it) and change every value:
#   cp .env.example .env
# The values below are placeholders for a local demo only. Never reuse them on a reachable machine.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits and symbols.
SQL_SA_PASSWORD=Change_Me_Sql_Passw0rd!

# Key that signs the API's JWTs: at least 32 random characters, for example: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-at-least-32-random-characters-0123456789

# Dashboard users created on the first start (user names: admin and viewer).
ADMIN_PASSWORD=change-me-admin-password
VIEWER_PASSWORD=change-me-viewer-password

# API key of the demo agent (it reports as docker-demo).
AGENT_API_KEY=change-me-demo-agent-key-0123456789
