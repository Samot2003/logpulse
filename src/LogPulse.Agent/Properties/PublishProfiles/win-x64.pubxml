<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet publish src/LogPulse.Agent -p:PublishProfile=win-x64
     Self-contained single executable: the target server needs no .NET runtime. appsettings.json stays next to it. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\agent-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
