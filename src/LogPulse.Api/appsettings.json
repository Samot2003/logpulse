{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LogPulse": ""
  },
  "Jwt": {
    "Issuer": "logpulse",
    "Audience": "logpulse",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MaxSessionDays": 30
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Retention": {
    "Enabled": true,
    "Interval": "01:00:00",
    "LogRetentionDays": 30,
    "MetricRetentionDays": 7,
    "BatchSize": 4000
  },
  "Seed": {
    "Users": [],
    "Agents": []
  }
}
